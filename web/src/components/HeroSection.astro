---
import { imageUrl } from '~/lib/imageUrl'
import { createDataAttribute } from '@sanity/visual-editing'
import type { SiteSettings } from '~/lib/queries'

interface Props {
  settings?: SiteSettings | null
}

const { settings } = Astro.props

const bgImage = settings?.heroBackground?.asset
  ? imageUrl(settings.heroBackground, {width: 1920, height: 800, quality: 85})
  : null
---

<section class="flex flex-col bg-black lg:block lg:relative lg:overflow-hidden desktop-hero-height">
  <!-- Background image wrapper: 50vh block on mobile, absolute fill on desktop -->
  <div class="relative h-[37vh] overflow-hidden lg:absolute lg:inset-0 lg:h-auto">
    {bgImage && (
      <img
        src={bgImage}
        alt={settings?.heroBackground?.alt ?? 'Antonio Martinez – Sharp by Tony'}
        fetchpriority="high"
        class="w-full h-full object-cover object-[85%_top] lg:object-[70%_center]"
        width="1920"
        height="800"
      />
    )}
  </div>

  <!-- Dark gradient left overlay — desktop only -->
  <div
    class="hidden lg:block absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- Content card: below image on mobile, overlaid on desktop -->
  <div class="relative z-10 px-6 py-8 lg:h-full lg:flex lg:items-center lg:px-[120px] lg:py-0" style="min-height: inherit;">
    <div
      class="hero-card max-w-[600px] lg:bg-black/85 lg:border lg:border-neutral-800 lg:rounded-sm lg:p-8 lg:shadow-xl"
    >
      <!-- Services tag line -->
      <p
        class="text-[14px] font-normal tracking-[0.25em] uppercase mb-2"
        style="color: #F5C645; text-shadow: rgba(0,0,0,0.4) 0px 4px 5px;"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'heroKicker'})() : undefined}
      >
        {settings?.heroKicker ?? 'VIDEO | PHOTO | DESIGN'}
      </p>

      <!-- Tagline -->
      <h1
        class="text-white text-[24px] font-bold tracking-widest uppercase mb-6"
        style="text-shadow: rgba(0,0,0,0.4) 0px 4px 5px;"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'tagline'})() : undefined}
      >
        {settings?.tagline ?? 'Sharp & Strategic Visuals.'}
      </h1>

      <!-- Body copy -->
      <p
        class="text-white/80 text-[18px] leading-relaxed mb-6"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'heroBody'})() : undefined}
      >
        {settings?.heroBody ?? 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.'}
      </p>

      <!-- CTA -->
      <a
        href="#contact-form"
        class="inline-block bg-[#F5C645] text-black text-[13px] font-bold tracking-widest uppercase px-6 py-3 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black cursor-pointer"
      >
        {settings?.heroCta ?? 'Book Your Shoot'}
      </a>
    </div>
  </div>

  <!-- Bottom diagonal divider — desktop only -->
  <div class="hidden lg:block absolute bottom-0 left-0 w-full overflow-hidden leading-[0]" aria-hidden="true">
    <svg
      viewBox="0 0 1200 100"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
      class="block w-full h-[100px]"
    >
      <polygon points="0,100 1200,0 1200,100" fill="#F5C645"></polygon>
    </svg>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .desktop-hero-height {
      min-height: max(560px, calc(100svh - 220px));
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-card {
      animation: fade-up 0.6s ease-out both;
    }
  }
</style>
