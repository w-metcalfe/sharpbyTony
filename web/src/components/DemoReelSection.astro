---
import type { SiteSettings, HomePage } from '~/lib/queries'
import {stegaClean} from '@sanity/client/stega'

interface Props {
  settings?: SiteSettings | null
  homePage?: HomePage | null
}

const { homePage } = Astro.props

const reel = homePage?.primaryReelVideo
let videoId: string | null = null
if (reel?.provider === 'youtube') {
  videoId = stegaClean(reel.url).match(/(?:v=|youtu\.be\/)([^&?/]+)/)?.[1] ?? null
}
---

<section class="relative w-full bg-black">
  <div class="relative w-full aspect-video" id="demo-reel-wrapper">
    {videoId ? (
      <>
        <!-- Mobile: plain iframe with default YouTube controls, no autoplay -->
        <iframe
          src={`https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`}
          title="Sharp by Tony – Demo Reel"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="md:hidden absolute inset-0 w-full h-full border-0"
        />
        <!-- Desktop: YT Player API with custom autoplay/cursor/click-restart -->
        <div id="demo-reel-player" class="hidden md:block absolute inset-0 w-full h-full" />
        <div id="demo-reel-overlay" class="hidden md:block absolute inset-0 z-10 cursor-none" />
        <div id="demo-reel-cursor" class="pointer-events-none absolute z-20 hidden -translate-x-1/2 -translate-y-1/2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="128" height="128" aria-hidden="true">
            <circle cx="32" cy="32" r="32" fill="#F5C645" />
            <polygon points="24,18 24,46 48,32" fill="black" />
          </svg>
        </div>
      </>
    ) : (
      <div class="absolute inset-0 bg-neutral-900" aria-hidden="true" />
    )}
  </div>
</section>

<script define:vars={{ videoId }}>
  if (videoId && window.innerWidth >= 768) {
    const wrapper = document.getElementById('demo-reel-wrapper')
    const overlay = document.getElementById('demo-reel-overlay')
    const cursor  = document.getElementById('demo-reel-cursor')

    // Inject YouTube IFrame API if not already present
    if (!window.YT) {
      const tag = document.createElement('script')
      tag.src = 'https://www.youtube.com/iframe_api'
      document.head.appendChild(tag)
    }

    let player = null

    function initPlayer() {
      player = new YT.Player('demo-reel-player', {
        videoId,
        playerVars: {
          autoplay: 1,
          mute: 1,
          controls: 0,
          loop: 1,
          playlist: videoId,
          rel: 0,
          modestbranding: 1,
          playsinline: 1,
        },
        events: {
          onReady: (e) => e.target.playVideo(),
        },
      })
    }

    if (window.YT?.Player) {
      initPlayer()
    } else {
      window.onYouTubeIframeAPIReady = initPlayer
    }

    // Custom cursor follows mouse within the wrapper
    let lastX = 0, lastY = 0

    function updateCursor() {
      const rect = wrapper.getBoundingClientRect()
      cursor.style.left = (lastX - rect.left) + 'px'
      cursor.style.top  = (lastY - rect.top)  + 'px'
    }

    overlay.addEventListener('mousemove', (e) => {
      lastX = e.clientX
      lastY = e.clientY
      updateCursor()
    })
    overlay.addEventListener('mouseenter', () => cursor.classList.remove('hidden'))
    overlay.addEventListener('mouseleave', () => cursor.classList.add('hidden'))
    window.addEventListener('scroll', () => {
      if (!cursor.classList.contains('hidden')) updateCursor()
    }, { passive: true })

    // Click: restart from beginning, unmute
    overlay.addEventListener('click', () => {
      if (!player?.seekTo) return
      cursor.classList.add('hidden')
      overlay.remove()
      player.seekTo(0)
      player.unMute()
      player.setVolume(100)
      player.playVideo()
    })
  }
</script>
