---
import type { SiteSettings } from '~/lib/queries'

interface Props {
  settings?: SiteSettings | null
}

const { settings } = Astro.props

const reel = settings?.primaryReelVideo
let embedUrl: string | null = null

if (reel) {
  if (reel.provider === 'youtube') {
    const id = reel.url.match(/(?:v=|youtu\.be\/)([^&?/]+)/)?.[1]
    if (id) embedUrl = `https://www.youtube.com/embed/${id}?rel=0&modestbranding=1`
  } else if (reel.provider === 'vimeo') {
    const id = reel.url.match(/vimeo\.com\/(\d+)/)?.[1]
    if (id) embedUrl = `https://player.vimeo.com/video/${id}?dnt=1`
  }
}
---

<section class="relative w-full bg-black">
  <!-- Full-bleed video / placeholder -->
  <div class="relative w-full aspect-video">
    {
      embedUrl ? (
        <iframe
          src={embedUrl}
          title="Sharp by Tony – Demo Reel"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 w-full h-full border-0"
        />
      ) : (
        /* Dark background only — overlay below handles all UI */
        <div class="absolute inset-0 bg-neutral-900" aria-hidden="true" />
      )
    }

    <!-- Overlay: title top · play middle · CTA bottom -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-8 py-12 bg-black/30 lg:justify-between lg:gap-0">
      <!-- Title -->
      <h2
        class="text-white text-[28px] font-bold tracking-widest uppercase"
        style="text-shadow: rgba(0,0,0,0.6) 0px 2px 8px;"
      >
        DEMO REEL
      </h2>

      <!-- Play button -->
      <a
        href="/demo-reel"
        class="flex items-center gap-3 text-white hover:text-[#F5C645] transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black"
        aria-label="Watch demo reel"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="w-14 h-14"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" />
          <polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none" />
        </svg>
        <span class="hidden lg:inline text-[15px] font-bold tracking-widest uppercase underline underline-offset-4">
          Play Video
        </span>
      </a>

      <!-- All Videos CTA -->
      <a
        href="/videos"
        class="hidden lg:inline-flex items-center gap-2 border border-white text-white text-[13px] font-bold tracking-widest uppercase px-8 py-3 transition-colors hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black"
      >
        All Videos
        <span aria-hidden="true">+</span>
      </a>
    </div>
  </div>
</section>
