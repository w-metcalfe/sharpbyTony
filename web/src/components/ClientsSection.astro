---
import { imageUrl } from '~/lib/imageUrl'
import { stegaClean } from '@sanity/client/stega'
import { createDataAttribute } from '@sanity/visual-editing'
import type { FeaturedClient } from '~/lib/queries'

interface Props {
  clients?: FeaturedClient[]
}

const { clients } = Astro.props

const sanityClients = (clients ?? []).filter((c) => c.logo?.asset)

const imgClass =
  'max-h-[40px] w-auto object-contain opacity-70 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-200'
---

<section class="bg-neutral-100 py-10 overflow-hidden">
  <div class="marquee-track">
    <div class="marquee-inner">
      {
        [...sanityClients, ...sanityClients].map((c) => (
          <a
            href={c.website ? stegaClean(c.website) : '#'}
            target={c.website ? '_blank' : undefined}
            rel={c.website ? 'noreferrer noopener' : undefined}
            class="flex-none flex items-center justify-center"
            data-sanity={createDataAttribute({ id: c._id, type: 'client', path: 'logo' })()}
          >
            <img
              src={imageUrl(c.logo, { width: 300 })}
              alt={c.name}
              width="300"
              class={imgClass}
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee-track {
    width: 100%;
    overflow: hidden;
  }

  .marquee-inner {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
  }
</style>

<script>
  // Driven by rAF + elapsed wall-clock time rather than a CSS animation:
  // CSS animation-duration has been observed to run faster on high-refresh-rate
  // displays (common on Windows, rare on Mac), so a fixed-duration keyframe
  // animation scrolls at different speeds depending on the monitor's Hz.
  const PIXELS_PER_SECOND = 60

  document.querySelectorAll<HTMLElement>('.marquee-inner').forEach((track) => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (prefersReducedMotion) return

    let offset = 0
    let paused = false
    let lastTimestamp: number | null = null

    track.addEventListener('mouseenter', () => (paused = true))
    track.addEventListener('mouseleave', () => (paused = false))

    function step(timestamp: number) {
      if (lastTimestamp === null) lastTimestamp = timestamp
      const deltaSeconds = (timestamp - lastTimestamp) / 1000
      lastTimestamp = timestamp

      // Track content is duplicated once, so half its width is one full loop.
      const halfWidth = track.scrollWidth / 2

      if (!paused && halfWidth > 0) {
        offset += PIXELS_PER_SECOND * deltaSeconds
        if (offset >= halfWidth) offset -= halfWidth
        track.style.transform = `translateX(-${offset}px)`
      }

      requestAnimationFrame(step)
    }

    requestAnimationFrame(step)
  })
</script>
