---
import { imageUrl } from '~/lib/imageUrl'
import { createDataAttribute } from '@sanity/visual-editing'
import type { FeaturedClient } from '~/lib/queries'

interface Props {
  clients?: FeaturedClient[]
}

const { clients } = Astro.props

const sanityClients = (clients ?? []).filter((c) => c.logo?.asset)

const imgClass =
  'max-h-[40px] w-auto object-contain opacity-70 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-200'
---

<section class="bg-neutral-100 py-10 overflow-hidden">
  <div class="marquee-track">
    <div class="marquee-inner">
      {
        [...sanityClients, ...sanityClients].map((c) => (
          <a
            href={c.website ?? '#'}
            target={c.website ? '_blank' : undefined}
            rel={c.website ? 'noreferrer noopener' : undefined}
            class="flex-none flex items-center justify-center"
            data-sanity={createDataAttribute({ id: c._id, type: 'client', path: 'logo' })()}
          >
            <img
              src={imageUrl(c.logo, { width: 300 })}
              alt={c.name}
              width="300"
              class={imgClass}
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee-track {
    width: 100%;
    overflow: hidden;
  }

  .marquee-inner {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
    animation: marquee 35s linear infinite;
  }

  .marquee-inner:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
