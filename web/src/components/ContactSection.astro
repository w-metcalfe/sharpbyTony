---
import { stegaClean } from '@sanity/client/stega'
import { createDataAttribute } from '@sanity/visual-editing'
import type { SiteSettings } from '~/lib/queries'

interface Props {
  settings?: SiteSettings | null
}

const { settings } = Astro.props

const email = settings?.contactEmail ?? 'TONY@SHARPBYTONY.COM'
// stegaClean strips invisible stega chars so href and regex aren't broken
const emailHref = stegaClean(email)
const rawPhone = settings?.contactPhone ?? '5199027253'
const phoneHref = stegaClean(rawPhone)
// Format as 519 . 902 . 7253
const phone = phoneHref.replace(/(\d{3})(\d{3})(\d{4})/, '$1 . $2 . $3')

const socials = settings?.socialLinks ?? [
  { platform: 'facebook', url: 'https://www.facebook.com/sharpbytony' },
  { platform: 'instagram', url: 'https://www.instagram.com/therealmexipino/' },
  { platform: 'linkedin', url: 'https://www.linkedin.com/in/antonio-martinez-b44b2b195/' },
]
---

<section class="bg-black py-0">
  <div class="grid md:grid-cols-2">
    <!-- Left: contact info on white card -->
    <div class="bg-white px-10 py-16 flex flex-col justify-center">
      <h2
        class="text-[48px] font-bold tracking-tight mb-6 text-black"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'contactHeading'})() : undefined}
      >
        {settings?.contactHeading ?? "Let's Get To Work"}
      </h2>

      <a
        href={`mailto:${emailHref}`}
        class="text-[12px] font-bold tracking-widest uppercase text-black hover:text-[#F5C645] transition-colors mb-5 inline-block focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-sm"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'contactEmail'})() : undefined}
      >
        {email.toUpperCase()}
      </a>

      <a
        href={`tel:${phoneHref}`}
        class="text-[28px] font-bold text-black hover:text-[#F5C645] transition-colors inline-block mb-8 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-sm"
        data-sanity={settings ? createDataAttribute({id: 'siteSettings', type: 'siteSettings', path: 'contactPhone'})() : undefined}
      >
        {phone}
      </a>

      <!-- Social icons -->
      <div class="flex gap-3" aria-label="Social links">
        {
          socials.map(({ platform, url }) => (
            <a
              href={stegaClean(url)}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`Sharp by Tony on ${platform}`}
              class="w-10 h-10 bg-black text-white flex items-center justify-center rounded-sm hover:bg-[#F5C645] hover:text-black transition-colors focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 cursor-pointer"
            >
              {platform === 'facebook' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
              )}
              {platform === 'instagram' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
              )}
              {platform === 'linkedin' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right: contact form on dark background -->
    <div class="bg-[#111111] px-10 py-16">
      <form
        id="contact-form"
        name="contact"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="flex flex-col gap-5"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this: <input name="bot-field" /></label>
        </p>

        <p class="text-neutral-400 text-[12px] tracking-wide">
          <span style="color: #F5C645;" aria-hidden="true">*</span> indicates required field
        </p>

        <div>
          <label
            for="contact-name"
            class="block text-[13px] font-bold tracking-wide text-white mb-2"
          >
            Name <span style="color: #F5C645;" aria-hidden="true">*</span>
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            placeholder="Enter your name"
            required
            maxlength="100"
            autocomplete="name"
            class="w-full bg-transparent border border-neutral-600 text-white placeholder-neutral-500 text-[13px] px-4 py-3 focus:outline-none focus:border-[#F5C645] focus:ring-1 focus:ring-[#F5C645] transition-colors"
          />
        </div>

        <div>
          <label
            for="contact-email"
            class="block text-[13px] font-bold tracking-wide text-white mb-2"
          >
            Email <span style="color: #F5C645;" aria-hidden="true">*</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            placeholder="Enter your email"
            required
            maxlength="250"
            autocomplete="email"
            class="w-full bg-transparent border border-neutral-600 text-white placeholder-neutral-500 text-[13px] px-4 py-3 focus:outline-none focus:border-[#F5C645] focus:ring-1 focus:ring-[#F5C645] transition-colors"
          />
        </div>

        <div>
          <label
            for="contact-phone"
            class="block text-[13px] font-bold tracking-wide text-white mb-2"
          >
            Phone <span style="color: #F5C645;" aria-hidden="true">*</span>
          </label>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            placeholder="Enter your phone number"
            required
            maxlength="50"
            autocomplete="tel"
            class="w-full bg-transparent border border-neutral-600 text-white placeholder-neutral-500 text-[13px] px-4 py-3 focus:outline-none focus:border-[#F5C645] focus:ring-1 focus:ring-[#F5C645] transition-colors"
          />
        </div>

        <div>
          <label
            for="contact-message"
            class="block text-[13px] font-bold tracking-wide text-white mb-2"
          >
            Tell us more about your project
          </label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Type your message here..."
            rows="5"
            autocomplete="off"
            class="w-full bg-transparent border border-neutral-600 text-white placeholder-neutral-500 text-[13px] px-4 py-3 focus:outline-none focus:border-[#F5C645] focus:ring-1 focus:ring-[#F5C645] transition-colors resize-none"
          ></textarea>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="bg-[#F5C645] text-black text-[13px] font-bold tracking-widest uppercase py-3 px-8 w-full transition-opacity hover:opacity-90 mt-1 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#F5C645] focus:ring-offset-2 focus:ring-offset-[#111111] disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Submit
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!submitBtn || !form) return

    submitBtn.textContent = 'Sending…'
    submitBtn.disabled = true

    try {
      const data = new FormData(form)
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      })

      if (res.ok) {
        window.location.href = '/thank-you'
      } else {
        submitBtn.textContent = 'Submit'
        submitBtn.disabled = false
      }
    } catch {
      submitBtn.textContent = 'Submit'
      submitBtn.disabled = false
    }
  })
</script>
