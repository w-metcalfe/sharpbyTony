---
import { imageUrl } from '~/lib/imageUrl'
import { createDataAttribute } from '@sanity/visual-editing'
import type { SiteSettings, HomePage } from '~/lib/queries'

interface Props {
  settings?: SiteSettings | null
  homePage?: HomePage | null
}

const { homePage } = Astro.props

const portrait = homePage?.aboutPortrait?.asset
  ? imageUrl(homePage.aboutPortrait, {width: 448, height: 630, quality: 80})
  : null

const FALLBACK_BODY =
  'I provide high-quality, yet true-to-life visual content for individuals, businesses and agencies alike. That led to marketing strategies and optimizing their own digital presence.\n\nBy providing powerful visuals, I help businesses tell powerful stories that sell and change minds. My goal is to create an emotional connection that lasts beyond their initial experience.'

const FALLBACK_QUOTE =
  'It is my policy to only offer you sharp content that reaches your goals and exceeds your expectations.'

const aboutBody = homePage?.aboutBody ?? FALLBACK_BODY
const paragraphs = aboutBody.split(/\n\n+/).filter(Boolean)
---

<section id="about-section" class="bg-white relative pt-16 pb-20">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 items-center">

      <!-- Left: text content -->
      <div data-animate>
        <h2
          class="text-[48px] font-bold tracking-tight mb-6 text-black"
          data-sanity={homePage ? createDataAttribute({id: 'homePage', type: 'homePage', path: 'aboutHeading'})() : undefined}
        >
          {homePage?.aboutHeading ?? 'About Me'}
        </h2>

        <div
          data-sanity={homePage ? createDataAttribute({id: 'homePage', type: 'homePage', path: 'aboutBody'})() : undefined}
        >
          {paragraphs.map((p) => (
            <p class="text-[15px] leading-[1.875] text-neutral-700 mb-5">{p}</p>
          ))}
        </div>

        <!-- Pull quote -->
        <blockquote class="border-l-4 border-[#F5C645] pl-4 mb-8">
          <p
            class="text-[15px] leading-[1.875] text-neutral-800 italic"
            data-sanity={homePage ? createDataAttribute({id: 'homePage', type: 'homePage', path: 'aboutQuote'})() : undefined}
          >
            "{homePage?.aboutQuote ?? FALLBACK_QUOTE}"
          </p>
          <footer class="mt-2 text-[12px] font-bold tracking-widest uppercase text-neutral-500">— Tony</footer>
        </blockquote>

        <!-- CTA -->
        <a
          href="#contact-form"
          class="inline-block bg-[#F5C645] text-black text-[13px] font-bold tracking-widest uppercase px-6 py-3 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 cursor-pointer"
        >
          {homePage?.heroCta ?? 'Book Your Shoot'}
        </a>
      </div>

      <!-- Right: portrait -->
      <div class="relative" data-animate data-delay="150">
        {portrait && (
          <img
            src={portrait}
            alt={homePage?.aboutPortrait?.alt ?? 'Antonio Martinez – Sharp by Tony'}
            width="448"
            height="630"
            class="w-full max-w-[380px] mx-auto object-cover"
            loading="lazy"
          />
        )}
      </div>
    </div>
  </div>

  <!-- Bottom divider → into dark demo reel section -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0]" aria-hidden="true">
    <svg
      viewBox="0 0 1200 36"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
      class="block w-full h-[36px]"
    >
      <polygon points="0,0 1200,36 0,36" fill="#F5C645"></polygon>
    </svg>
  </div>
</section>

<style>
  [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0
            setTimeout(() => el.classList.add('is-visible'), delay)
            observer.unobserve(el)
          }
        })
      },
      { threshold: 0.15 }
    )

    document.querySelectorAll('#about-section [data-animate]').forEach((el) => observer.observe(el))
  }
</script>
