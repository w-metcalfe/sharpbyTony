---
import { createDataAttribute } from '@sanity/visual-editing'
import type { FeaturedTestimonial, SiteSettings, HomePage } from '~/lib/queries'

interface Props {
  testimonials?: FeaturedTestimonial[]
  settings?: SiteSettings | null
  homePage?: HomePage | null
  heading?: string
  headingSanityAttr?: string
}

const { testimonials, homePage, heading, headingSanityAttr } = Astro.props

const FALLBACK_TESTIMONIALS: FeaturedTestimonial[] = [
  {
    _id: '1',
    quote:
      'Great company to work with to create digital video assets. They quickly understood our goals and planned and created some great promotional videos for us within a short period of time. Will definitely use again when the need arises.',
    authorName: 'Mark Brunnenmeir',
    authorRole: 'Owner',
    authorCompany: 'Opportunity Bridal',
  },
  {
    _id: '2',
    quote:
      "I've worked extensively with this company and have had great experiences every time. They are professional, prompt and creative. I would definitely recommend them.",
    authorName: 'Anthony Dickson',
    authorRole: 'Host',
    authorCompany: 'Line of Sight TV',
  },
  {
    _id: '3',
    quote:
      'Antonio made us some great ad videos that we have used for social media and websites as well as YouTube.',
    authorName: 'Andrew Crook',
    authorRole: 'Broker of Record & CFO',
    authorCompany: 'PC275 Realty',
  },
  {
    _id: '4',
    quote:
      "Always such a pleasure working with Antonio! He's collaborated with me on both photo and video projects — on my own productions, social media content as well as co-producing projects together. Antonio thinks through every step, every shot, and always finds ways to elevate the visuals.",
    authorName: 'Willi Van Deven',
    authorRole: undefined,
    authorCompany: "Designer's Edge / Covers Canada",
  },
  {
    _id: '5',
    quote:
      'We are very pleased with the videos Antonio produced for us. He was flexible and easy to work with. Thank you for the great job.',
    authorName: 'Matt Soroka',
    authorRole: 'Marketing Rep',
    authorCompany: 'T-BO',
  },
  {
    _id: '6',
    quote:
      'Great experience. Attentive and always follow ups. The final product was as expected and we were happy.',
    authorName: 'Ramzi Zain',
    authorRole: 'Owner',
    authorCompany: 'Zain Brands',
  },
  {
    _id: '7',
    quote:
      'I had an amazing experience working with Antonio! This was my first time getting professional photos for my business, and he made the entire process so smooth and enjoyable. Antonio was professional, friendly, and made me feel completely at ease throughout the shoot.',
    authorName: 'Vanessa Eedy',
    authorRole: 'Doctor of Naturopathy',
    authorCompany: undefined,
  },
  {
    _id: '8',
    quote: 'Great prices and brilliant at what he does!',
    authorName: 'Ammar Bukhari',
    authorRole: 'Owner',
    authorCompany: 'Saltus Paralegal Services',
  },
  {
    _id: '9',
    quote: 'Absolutely miraculous and delivers exactly as per your vision.',
    authorName: 'Client',
    authorRole: undefined,
    authorCompany: undefined,
  },
]

const hasSanityTestimonials = testimonials && testimonials.length > 0
const items = hasSanityTestimonials ? testimonials : FALLBACK_TESTIMONIALS
---

<section id="testimonials-section" class="bg-black py-20">
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-white text-[32px] md:text-[40px] font-bold tracking-tight text-center mb-14"
      data-sanity={headingSanityAttr ?? (homePage ? createDataAttribute({id: 'homePage', type: 'homePage', path: 'testimonialsHeading'})() : undefined)}
    >
      {heading ?? homePage?.testimonialsHeading ?? 'Testimonials'}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {
        items.map((t, i) => (
          <div
            class="flex flex-col bg-neutral-900 border border-neutral-800 rounded-sm p-6"
            data-animate
            data-delay={Math.min(i, 5) * 80}
            data-sanity={hasSanityTestimonials ? createDataAttribute({id: t._id, type: 'testimonial', path: 'quote'})() : undefined}
          >
            {/* Decorative quotation mark */}
            <div
              class="text-[48px] leading-none font-serif mb-2 select-none"
              style="color: #F5C645; font-family: Georgia, serif; line-height: 1;"
              aria-hidden="true"
            >
              &ldquo;
            </div>

            <p class="text-white text-[18px] leading-[1.8] mb-5 flex-1">{t.quote}</p>

            {/* 5-star rating */}
            <div class="flex gap-1 mb-4" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#F5C645" class="w-5 h-5" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))}
            </div>

            <div>
              <p class="text-white font-bold text-[18px] tracking-wide">{t.authorName}</p>
              {(t.authorRole || t.authorCompany) && (
                <p class="text-neutral-400 text-[14px] mt-0.5">
                  {[t.authorRole, t.authorCompany].filter(Boolean).join(' | ')}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  #testimonials-section [data-animate] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  #testimonials-section [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #testimonials-section [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0
            setTimeout(() => el.classList.add('is-visible'), delay)
            observer.unobserve(el)
          }
        })
      },
      { threshold: 0.08 }
    )

    document
      .querySelectorAll('#testimonials-section [data-animate]')
      .forEach((el) => observer.observe(el))
  }
</script>
