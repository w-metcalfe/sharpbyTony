---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Header from '~/components/Header.astro'
import ContactSection from '~/components/ContactSection.astro'
import Footer from '~/components/Footer.astro'

import {loadQuery} from '~/lib/load-query'
import {getDraftModeProps} from '~/lib/draft-mode'
import {imageUrl} from '~/lib/imageUrl'
import {stegaClean} from '@sanity/client/stega'
import {
  SITE_SETTINGS_QUERY,
  HOME_PAGE_QUERY,
  PAGE_BY_SLUG_QUERY,
  type SiteSettings,
  type HomePage,
  type Page,
} from '~/lib/queries'

const draftProps = getDraftModeProps(Astro.cookies)

const [{data: settings}, {data: homePage}, {data: page}] = await Promise.all([
  loadQuery<SiteSettings | null>({query: SITE_SETTINGS_QUERY, ...draftProps}).catch(() => ({
    data: null,
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<HomePage | null>({query: HOME_PAGE_QUERY, ...draftProps}).catch(() => ({
    data: null,
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<Page | null>({
    query: PAGE_BY_SLUG_QUERY,
    params: {slug: 'demo-reel'},
    ...draftProps,
  }).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
])

// SEO
const pageTitle = page?.seo?.metaTitle ?? `Demo Reel | ${settings?.title ?? 'Sharp by Tony'}`
const pageDescription =
  page?.seo?.metaDescription ??
  'Watch the Sharp by Tony demo reel — sharp, strategic video production in London, Ontario.'
const ogImageUrl = page?.seo?.ogImage?.asset
  ? imageUrl(page.seo.ogImage, {width: 1200, height: 630, quality: 85})
  : undefined
const noIndex = page?.seo?.noIndex ?? false
const favicon = settings?.favicon?.asset ? imageUrl(settings.favicon, {width: 32, height: 32}) : undefined

const reel = homePage?.primaryReelVideo
let embedUrl: string | null = null
if (reel?.provider === 'youtube') {
  const id = stegaClean(reel.url).match(/(?:v=|youtu\.be\/)([^&?/]+)/)?.[1]
  if (id) embedUrl = `https://www.youtube.com/embed/${id}?rel=0&modestbranding=1&autoplay=1`
} else if (reel?.provider === 'vimeo') {
  const id = stegaClean(reel.url).match(/vimeo\.com\/(\d+)/)?.[1]
  if (id) embedUrl = `https://player.vimeo.com/video/${id}?dnt=1&autoplay=1`
}

const posterFrameUrl = reel?.posterFrame?.asset
  ? imageUrl(reel.posterFrame, {width: 1920, quality: 85})
  : null
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImageUrl}
  favicon={favicon}
  noIndex={noIndex}
  contactEmail={settings?.contactEmail}
  contactPhone={settings?.contactPhone}
  address={settings?.address}
>
  <Header currentPath="/demo-reel" settings={settings} />

  <main id="main-content">

    <!-- ─────────────────────────── VIDEO HERO ─────────────────────────── -->
    <section class="relative w-full bg-black" aria-label="Demo reel hero">
      <h1 class="sr-only">Sharp by Tony – Demo Reel</h1>
      <div class="relative w-full aspect-video" id="reel-container">
        {embedUrl ? (
          <>
            {posterFrameUrl && (
              <button
                id="reel-poster"
                class="absolute inset-0 w-full h-full border-0 p-0 cursor-pointer group"
                aria-label="Play demo reel"
              >
                <img
                  src={posterFrameUrl}
                  alt="Demo reel poster frame"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <span class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors">
                  <svg class="w-20 h-20 text-white drop-shadow-lg" viewBox="0 0 80 80" fill="currentColor" aria-hidden="true">
                    <circle cx="40" cy="40" r="40" fill="rgba(0,0,0,0.45)" />
                    <polygon points="32,24 60,40 32,56" fill="white" />
                  </svg>
                </span>
              </button>
            )}
            <iframe
              id="reel-iframe"
              src={posterFrameUrl ? 'about:blank' : embedUrl}
              data-src={embedUrl}
              title="Sharp by Tony – Demo Reel"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class={`absolute inset-0 w-full h-full border-0${posterFrameUrl ? ' hidden' : ''}`}
            />
          </>
        ) : (
          <div class="absolute inset-0 bg-neutral-900" aria-hidden="true" />
        )}
      </div>
    </section>

    <script>
      const poster = document.getElementById('reel-poster')
      const iframe = document.getElementById('reel-iframe') as HTMLIFrameElement | null
      if (poster && iframe) {
        poster.addEventListener('click', () => {
          iframe.src = iframe.dataset.src ?? ''
          iframe.classList.remove('hidden')
          poster.remove()
        })
      }
    </script>

    <!-- ──────────────────────── CONTACT ──────────────────────── -->
    <ContactSection settings={settings} />
  </main>

  <Footer settings={settings} />
</BaseLayout>

