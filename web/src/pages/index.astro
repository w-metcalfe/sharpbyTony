---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Header from '~/components/Header.astro'
import HeroSection from '~/components/HeroSection.astro'
import ClientsSection from '~/components/ClientsSection.astro'
import AboutSection from '~/components/AboutSection.astro'
import DemoReelSection from '~/components/DemoReelSection.astro'
import ProjectHighlights from '~/components/ProjectHighlights.astro'
import TestimonialsSection from '~/components/TestimonialsSection.astro'
import ContactSection from '~/components/ContactSection.astro'
import Footer from '~/components/Footer.astro'

import {loadQuery} from '~/lib/load-query'
import {getDraftModeProps} from '~/lib/draft-mode'
import {imageUrl} from '~/lib/imageUrl'
import {
  SITE_SETTINGS_QUERY,
  HOME_PAGE_QUERY,
  FEATURED_CLIENTS_QUERY,
  FEATURED_PROJECTS_QUERY,
  FEATURED_TESTIMONIALS_QUERY,
  type SiteSettings,
  type HomePage,
  type FeaturedClient,
  type ProjectCard,
  type FeaturedTestimonial,
} from '~/lib/queries'

const draftProps = getDraftModeProps(Astro.cookies)

// Fetch all data in parallel; any individual failure returns null and the
// component falls back to hardcoded placeholder content.
const [
  {data: settings},
  {data: homePage},
  {data: clients},
  {data: projects},
  {data: testimonials},
] = await Promise.all([
  loadQuery<SiteSettings | null>({query: SITE_SETTINGS_QUERY, ...draftProps}).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<HomePage | null>({query: HOME_PAGE_QUERY, ...draftProps}).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<FeaturedClient[]>({query: FEATURED_CLIENTS_QUERY, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<ProjectCard[]>({query: FEATURED_PROJECTS_QUERY, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<FeaturedTestimonial[]>({query: FEATURED_TESTIMONIALS_QUERY, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
])

const title = settings
  ? `${settings.title} | Video · Photo · Design`
  : 'Sharp by Tony | Video · Photo · Design'

const description =
  settings?.description ??
  'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.'

const favicon = settings?.favicon?.asset ? imageUrl(settings.favicon, {width: 32, height: 32}) : undefined

const ogImageUrl = settings?.defaultOgImage?.asset
  ? imageUrl(settings.defaultOgImage, {width: 1200, height: 630, quality: 85})
  : undefined
---

<BaseLayout title={title} description={description} favicon={favicon} ogImage={ogImageUrl} contactEmail={settings?.contactEmail} contactPhone={settings?.contactPhone} address={settings?.address}>
  <Header currentPath="/" settings={settings} />

  <main id="main-content">
    <HeroSection settings={settings} homePage={homePage} />
    <ClientsSection clients={clients} />
    <AboutSection settings={settings} homePage={homePage} />
    <DemoReelSection settings={settings} homePage={homePage} />
    <ProjectHighlights projects={projects} settings={settings} homePage={homePage} />
    <TestimonialsSection testimonials={testimonials} settings={settings} homePage={homePage} />
    <ContactSection settings={settings} />
  </main>

  <Footer settings={settings} />
</BaseLayout>
