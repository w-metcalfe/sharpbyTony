---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Header from '~/components/Header.astro'
import HeroSection from '~/components/HeroSection.astro'
import ClientsSection from '~/components/ClientsSection.astro'
import AboutSection from '~/components/AboutSection.astro'
import DemoReelSection from '~/components/DemoReelSection.astro'
import ProjectHighlights from '~/components/ProjectHighlights.astro'
import TestimonialsSection from '~/components/TestimonialsSection.astro'
import ContactSection from '~/components/ContactSection.astro'
import Footer from '~/components/Footer.astro'

import {loadQuery} from '~/lib/load-query'
import {getDraftModeProps} from '~/lib/draft-mode'
import {imageUrl} from '~/lib/imageUrl'
import {
  siteSettingsQuery,
  featuredClientsQuery,
  featuredProjectsQuery,
  featuredTestimonialsQuery,
  type SiteSettings,
  type FeaturedClient,
  type ProjectCard,
  type FeaturedTestimonial,
} from '~/lib/queries'

const draftProps = getDraftModeProps(Astro.cookies)

// Fetch all data in parallel; any individual failure returns null and the
// component falls back to hardcoded placeholder content.
const [
  {data: settings},
  {data: clients},
  {data: projects},
  {data: testimonials},
] = await Promise.all([
  loadQuery<SiteSettings | null>({query: siteSettingsQuery, ...draftProps}).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<FeaturedClient[]>({query: featuredClientsQuery, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<ProjectCard[]>({query: featuredProjectsQuery, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<FeaturedTestimonial[]>({query: featuredTestimonialsQuery, ...draftProps}).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
])

const title = settings
  ? `${settings.title} | Video · Photo · Design`
  : 'Sharp by Tony | Video · Photo · Design'

const description =
  settings?.description ??
  'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.'

const favicon = settings?.favicon?.asset ? imageUrl(settings.favicon) : undefined
---

<BaseLayout title={title} description={description} favicon={favicon}>
  <Header currentPath="/" settings={settings} />

  <main id="main-content">
    <HeroSection settings={settings} />
    <ClientsSection clients={clients} />
    <AboutSection settings={settings} />
    <DemoReelSection settings={settings} />
    <ProjectHighlights projects={projects} settings={settings} />
    <TestimonialsSection testimonials={testimonials} settings={settings} />
    <ContactSection settings={settings} />
  </main>

  <Footer settings={settings} />
</BaseLayout>
