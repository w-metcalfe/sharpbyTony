---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Header from '~/components/Header.astro'
import TestimonialsSection from '~/components/TestimonialsSection.astro'
import ClientsSection from '~/components/ClientsSection.astro'
import ContactSection from '~/components/ContactSection.astro'
import Footer from '~/components/Footer.astro'

import {loadQuery} from '~/lib/load-query'
import {getDraftModeProps} from '~/lib/draft-mode'
import {imageUrl} from '~/lib/imageUrl'
import {stegaClean} from '@sanity/client/stega'
import {createDataAttribute} from '@sanity/visual-editing'
import {
  SITE_SETTINGS_QUERY,
  SERVICE_BY_SLUG_QUERY,
  FEATURED_TESTIMONIALS_QUERY,
  FEATURED_CLIENTS_QUERY,
  HOME_PAGE_QUERY,
  type SiteSettings,
  type ServiceDetail,
  type PortableTextBlock,
  type FeaturedTestimonial,
  type FeaturedClient,
  type HomePage,
} from '~/lib/queries'

const {slug} = Astro.params
if (!slug) return Astro.redirect('/photography')

const draftProps = getDraftModeProps(Astro.cookies)

const [{data: settings}, {data: service}, {data: testimonials}, {data: clients}, {data: homePage}] = await Promise.all([
  loadQuery<SiteSettings | null>({query: SITE_SETTINGS_QUERY, ...draftProps}).catch(() => ({
    data: null,
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<ServiceDetail | null>({
    query: SERVICE_BY_SLUG_QUERY,
    params: {slug},
    ...draftProps,
  }).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<FeaturedTestimonial[]>({query: FEATURED_TESTIMONIALS_QUERY, ...draftProps}).catch(() => ({
    data: [],
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<FeaturedClient[]>({query: FEATURED_CLIENTS_QUERY, ...draftProps}).catch(() => ({
    data: [],
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<HomePage | null>({query: HOME_PAGE_QUERY, ...draftProps}).catch(() => ({
    data: null,
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
])

const FALLBACK_ABOUT_PARAGRAPHS = [
  'From creative planning to final delivery, I work with anyone — from businesses to agencies to even individuals — to ensure every project is executed with both technical precision and creative intent. I work across a range of formats and platforms, using everything from FPV drones to cinema cameras, and have experience leading smaller crews on a variety of shoots.',
  'My background includes hands-on experience as a rental technician, where I helped manage a warehouse of high-end gear, as well as working as a grip and lighting technician on a range of high-end commercial sets, documentaries, and short films. These roles taught me the importance of gear QC, lighting setups, and working efficiently on fast-paced sets.',
]

const aboutParagraph = (() => {
  const blocks = service?.whyChooseUsBody ?? []
  const normalBlocks = blocks.filter((b) => (!b.style || b.style === 'normal') && !b.listItem)
  const text = normalBlocks[0] ? blockText(normalBlocks[0]) : null
  return text || FALLBACK_ABOUT_PARAGRAPHS[0]
})()

const aboutChecklistItems = (() => {
  const blocks = service?.whyChooseUsBody ?? []
  return blocks.filter((b) => b.listItem === 'bullet').map((b) => blockText(b)).filter(Boolean)
})()

const aboutPortrait = service?.whyChooseUsPortrait?.asset
  ? imageUrl(service.whyChooseUsPortrait, {width: 560, height: 700, quality: 80})
  : homePage?.aboutPortrait?.asset
    ? imageUrl(homePage.aboutPortrait, {width: 560, height: 700, quality: 80})
    : null

const reelVideo = homePage?.primaryReelVideo
const reelVideoId = reelVideo?.provider === 'youtube'
  ? stegaClean(reelVideo.url).match(/(?:v=|youtu\.be\/)([^&?/]+)/)?.[1] ?? null
  : null

if (!service) return Astro.redirect('/photography')

// SEO
const pageTitle =
  service.seo?.metaTitle ??
  `${service.title} | Video Production London Ontario | ${settings?.title ?? 'Sharp by Tony'}`
const pageDescription = service.seo?.metaDescription ?? service.summary
const ogImageUrl = service.seo?.ogImage?.asset
  ? imageUrl(service.seo.ogImage, {width: 1200, height: 630, quality: 85})
  : service.heroImage?.asset
    ? imageUrl(service.heroImage, {width: 1200, height: 630, quality: 85})
    : undefined
const noIndex = service.seo?.noIndex ?? false
const favicon = settings?.favicon?.asset ? imageUrl(settings.favicon, {width: 32, height: 32}) : undefined

const heroBg = service.heroImage?.asset
  ? imageUrl(service.heroImage, {width: 1920, height: 800, quality: 85})
  : null

function blockText(block: PortableTextBlock | undefined): string {
  return block?.children?.map((c) => c.text).join('') ?? ''
}

// Process section — editable per service
const FALLBACK_PROCESS_STEPS = [
  {
    label: 'DETAILED PLAN',
    body: 'In pre-production, I translate your vision and strategy into clear shot lists, visual mood boards, and scripts that set the creative direction. I also handle the details with lighting plans, equipment selection, and sourcing the right cast and crew so that everything is dialed in before the camera ever rolls.',
  },
  {
    label: 'PRODUCTION',
    body: 'During production, I execute the plan shot by shot—methodically checking off the shot list and capturing everything needed so the edit is smooth and efficient. Clients are often on set to weigh in on framing, performance, and delivery, ensuring alignment in real time.',
  },
  {
    label: 'EDITS & DELIVERY',
    body: 'Experience a thorough feedback session post-production to refine your video content. I ensure that your vision is realized, making necessary adjustments for a polished final product that meets your goals.',
  },
]

const processHeading = service?.processHeading ?? 'VIDEO PROCESS'
const processIntro = service?.processIntro ?? ''
const processSteps = (service?.processSteps && service.processSteps.length > 0)
  ? service.processSteps.map((s) => ({
      label: s.label,
      body: s.body,
      img: s.image?.asset ? imageUrl(s.image, {width: 560, height: 360, quality: 80}) : null,
      imgAlt: s.image?.alt ?? s.label,
    }))
  : FALLBACK_PROCESS_STEPS.map((s) => ({...s, img: null as string | null, imgAlt: s.label}))

// Service body (below process)
const serviceBody = service.body ?? []

const FALLBACK_ICONS = [
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
]

const FALLBACK_BENEFITS = [
  {headline: 'Detailed Pre-Production', body: 'Coming soon.', icon: FALLBACK_ICONS[0]},
  {headline: 'Professional Equipment', body: 'Coming soon.', icon: FALLBACK_ICONS[1]},
  {headline: 'On-Set Collaboration', body: 'Coming soon.', icon: FALLBACK_ICONS[2]},
  {headline: 'Seamless Post-Production', body: 'Coming soon.', icon: FALLBACK_ICONS[3]},
  {headline: 'Polished Delivery', body: 'Coming soon.', icon: FALLBACK_ICONS[4]},
  {headline: 'Strategic Storytelling', body: 'Coming soon.', icon: FALLBACK_ICONS[5]},
]

const benefits = service.benefits && service.benefits.length > 0
  ? service.benefits.map((b, i) => ({...b, icon: b.icon ?? FALLBACK_ICONS[i] ?? FALLBACK_ICONS[0]}))
  : FALLBACK_BENEFITS

// JSON-LD structured data — Service + FAQPage
const canonicalUrl = `https://sharpbytony.com/photography/${slug}`
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: stegaClean(service.title),
  description: stegaClean(service.seo?.metaDescription ?? service.summary ?? ''),
  serviceType: 'Photography',
  ...(ogImageUrl ? {image: ogImageUrl} : {}),
  url: canonicalUrl,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Sharp by Tony',
    url: 'https://sharpbytony.com',
    ...(settings?.contactEmail ? {email: stegaClean(settings.contactEmail)} : {}),
    ...(settings?.contactPhone ? {telephone: stegaClean(settings.contactPhone)} : {}),
    ...(settings?.address?.locality || settings?.address?.region
      ? {
          address: {
            '@type': 'PostalAddress',
            ...(settings.address.locality ? {addressLocality: stegaClean(settings.address.locality)} : {}),
            ...(settings.address.region ? {addressRegion: stegaClean(settings.address.region)} : {}),
          },
        }
      : {}),
  },
  areaServed: [
    {'@type': 'City', name: 'London, Ontario'},
    {'@type': 'City', name: 'Toronto'},
    {'@type': 'AdministrativeArea', name: 'Ontario'},
  ],
}

const faqLd = service.faq && service.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: service.faq.map((f) => ({
        '@type': 'Question',
        name: stegaClean(f.question),
        acceptedAnswer: {
          '@type': 'Answer',
          text: stegaClean(f.answer),
        },
      })),
    }
  : null
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImageUrl}
  favicon={favicon}
  noIndex={noIndex}
  contactEmail={settings?.contactEmail}
  contactPhone={settings?.contactPhone}
  address={settings?.address}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
    {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <Header currentPath={`/photography/${slug}`} settings={settings} />

  <main id="main-content">

    <!-- ─────────────────────────── HERO ─────────────────────────── -->
    <section class="relative w-full bg-black overflow-hidden flex items-center justify-center" style="min-height: clamp(320px, 55vh, 640px);" aria-label="Service hero">
      {heroBg && (
        <img
          src={heroBg}
          alt={service.heroImage.alt}
          fetchpriority="high"
          width="1920"
          height="800"
          class="absolute inset-0 w-full h-full object-cover object-center"
          data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'heroImage'})()}
        />
      )}
      <div class="absolute inset-0 bg-black/65" aria-hidden="true" />
      <div class="relative z-10 flex flex-col items-center justify-center h-full px-6 py-20 text-center">
        <div class="hero-text">
          <p class="text-[12px] font-bold tracking-[0.3em] uppercase mb-3" style="color: #F5C645;">
            PHOTO | SHARP BY TONY
          </p>
          <h1
            class="text-white text-[48px] md:text-[72px] font-bold tracking-tight leading-none mb-6"
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'title'})()}
          >
            {service.title}
          </h1>
          <p
            class="text-neutral-300 text-[16px] md:text-[18px] leading-relaxed max-w-xl mx-auto"
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'summary'})()}
          >
            {service.summary}
          </p>
          <div class="mt-8">
            <a
              href="#contact-form"
              class="inline-block bg-[#F5C645] text-black text-[13px] font-bold tracking-widest uppercase px-8 py-3.5 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black"
            >
              Book Your Shoot
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ──────────────────────── CLIENT LOGOS ──────────────────────── -->
    <ClientsSection clients={clients} />

    <!-- ──────────────────────── DEMO REEL ──────────────────────── -->
    {reelVideoId && (
      <section class="bg-black">
        <div class="max-w-5xl mx-auto px-6 py-12">
          <div class="w-full aspect-video">
            <iframe
              src={`https://www.youtube.com/embed/${reelVideoId}?rel=0&modestbranding=1`}
              title="Sharp by Tony – Demo Reel"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full border-0"
            />
          </div>
        </div>
      </section>
    )}

    <!-- ──────────────────────── WHY CHOOSE US ──────────────────────── -->
    <section class="bg-black py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">

          <!-- Left: text -->
          <div
            data-animate
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'whyChooseUsBody'})()}
          >
            <p class="text-[12px] font-bold tracking-[0.3em] uppercase mb-4" style="color: #F5C645;">
              {service.title}
            </p>
            <h2
              class="text-white text-[32px] md:text-[40px] font-bold tracking-tight leading-tight mb-6"
              data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'whyChooseUsHeading'})()}
            >
              {service.whyChooseUsHeading ?? `Why Choose Us for ${service.title}?`}
            </h2>
            <p class="text-neutral-400 text-[15px] leading-[1.875] mb-6">{aboutParagraph}</p>
            {aboutChecklistItems.length > 0 && (
              <ul class="space-y-3">
                {aboutChecklistItems.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="shrink-0 mt-0.5" style="color: #F5C645;" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span class="text-neutral-300 text-[15px] leading-[1.8]">{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <!-- Right: portrait -->
          <div class="relative" data-animate data-delay="150">
            {aboutPortrait ? (
              <img
                src={aboutPortrait}
                alt={service.whyChooseUsPortrait?.alt ?? homePage?.aboutPortrait?.alt ?? 'Antonio Martinez – Sharp by Tony'}
                width="560"
                height="700"
                class="w-full max-w-[420px] mx-auto object-cover"
                loading="lazy"
                data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'whyChooseUsPortrait'})()}
              />
            ) : (
              <div class="w-full max-w-[420px] mx-auto aspect-[4/5] bg-neutral-900" />
            )}
          </div>

        </div>
      </div>
    </section>

    <!-- ──────────────────────── BENEFITS ──────────────────────── -->
    <section class="bg-black py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="mb-12 text-center" data-animate>
          <p class="text-[12px] font-bold tracking-[0.3em] uppercase mb-3" style="color: #F5C645;">
            BENEFITS
          </p>
          <h2
            class="text-white text-[32px] md:text-[48px] font-bold tracking-tight"
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'benefitsHeading'})()}
          >
            {service.benefitsHeading ?? 'The Benefits'}
          </h2>
        </div>
        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-4"
          data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'benefits'})()}
        >
          {benefits.map((b, i) => (
            <div class="bg-neutral-900 p-6 flex flex-col gap-3" data-animate data-delay={i * 80}>
              <div style="color: #F5C645;" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={b.icon} />
              </div>
              <h3 class="text-white text-[18px] font-bold tracking-tight leading-snug">{b.headline}</h3>
              <p class="text-neutral-400 text-[14px] leading-[1.8]">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ──────────────────────── VIDEO PROCESS ──────────────────────── -->
    <section id="video-process" class="bg-black py-20">
      <div class="max-w-5xl mx-auto px-6">

        <div class="mb-14 text-center" data-animate>
          <h2
            class="text-white text-[32px] md:text-[48px] font-bold tracking-tight mb-6"
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'processHeading'})()}
          >
            {processHeading}
          </h2>
          {processIntro && (
            <p
              class="text-neutral-400 text-[16px] md:text-[18px] leading-relaxed max-w-2xl mx-auto"
              data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'processIntro'})()}
            >
              {processIntro}
            </p>
          )}
        </div>

        <div
          class="grid md:grid-cols-3 gap-6"
          data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'processSteps'})()}
        >
          {processSteps.map((step, i) => (
            <div class="flex flex-col" data-animate data-delay={i * 120}>
              <div class="aspect-video overflow-hidden mb-5 bg-neutral-900">
                {step.img && (
                  <img
                    src={step.img}
                    alt={step.imgAlt}
                    width="560"
                    height="360"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="text-[12px] font-bold tracking-[0.25em] mb-3" style="color: #F5C645;">
                {step.label}
              </p>
              <p class="text-neutral-400 text-[14px] leading-[1.8]">
                {step.body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ──────────────────────── TESTIMONIALS ──────────────────────── -->
    <TestimonialsSection
      testimonials={testimonials}
      settings={settings}
      heading={service.testimonialsHeading ?? 'Testimonials'}
      headingSanityAttr={createDataAttribute({id: service._id, type: 'service', path: 'testimonialsHeading'})()}
    />

    <!-- ──────────────────────── FAQ ──────────────────────── -->
    {service.faq && service.faq.length > 0 && (
      <section class="bg-black py-20">
        <div class="max-w-3xl mx-auto px-6">

          <div class="mb-12 text-center" data-animate>
            <p class="text-[12px] font-bold tracking-[0.3em] uppercase mb-3" style="color: #F5C645;">
              FAQ
            </p>
            <h2 class="text-white text-[32px] md:text-[48px] font-bold tracking-tight">
              Frequently Asked Questions
            </h2>
          </div>

          <div
            class="divide-y divide-neutral-800"
            data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'faq'})()}
          >
            {service.faq.map((item, i) => (
              <details class="faq-item" data-animate data-delay={i * 60}>
                <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none">
                  <span class="text-white text-[16px] md:text-[18px] font-bold tracking-tight leading-snug">
                    {item.question}
                  </span>
                  <span class="shrink-0" style="color: #F5C645;" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="faq-chevron w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </span>
                </summary>
                <p class="text-neutral-400 text-[15px] leading-[1.8] pb-5 pr-10">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>

        </div>
      </section>
    )}

    <!-- ─────────────────────────── SERVICE BODY ─────────────────────────── -->
    {serviceBody.length > 0 && (
      <section class="bg-black py-20">
        <div
          class="max-w-3xl mx-auto px-6 space-y-6"
          data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'body'})()}
        >
          {serviceBody.map((block) => {
            const text = blockText(block)
            if (!text) return null
            if (block.style === 'h2') {
              return (
                <h2 class="text-white text-[28px] md:text-[36px] font-bold tracking-tight leading-snug">
                  {text}
                </h2>
              )
            }
            if (block.style === 'h3') {
              return (
                <h3 class="text-white text-[22px] md:text-[28px] font-bold tracking-tight leading-snug">
                  {text}
                </h3>
              )
            }
            return (
              <p class="text-neutral-400 text-[16px] md:text-[18px] leading-[1.8]">
                {text}
              </p>
            )
          })}
        </div>
      </section>
    )}

    <!-- ──────────────────────── CONTACT ──────────────────────── -->
    <ContactSection settings={settings} />
  </main>

  <Footer settings={settings} />
</BaseLayout>

<style>
  @keyframes fade-up {
    from {opacity: 0; transform: translateY(24px);}
    to {opacity: 1; transform: translateY(0);}
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-text {
      animation: fade-up 0.6s ease-out both;
    }
  }

  [data-animate] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {opacity: 1; transform: none; transition: none;}
  }

  details.faq-item summary::-webkit-details-marker { display: none; }
  details.faq-item summary { user-select: none; }
  @media (prefers-reduced-motion: no-preference) {
    details.faq-item .faq-chevron {
      transition: transform 0.25s ease;
    }
    details.faq-item[open] .faq-chevron {
      transform: rotate(180deg);
    }
    details.faq-item[open] p {
      animation: faq-reveal 0.25s ease both;
    }
  }
  @keyframes faq-reveal {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0
            setTimeout(() => el.classList.add('is-visible'), delay)
            observer.unobserve(el)
          }
        })
      },
      {threshold: 0.12},
    )
    document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el))
  }
</script>
