---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Header from '~/components/Header.astro'
import ContactSection from '~/components/ContactSection.astro'
import Footer from '~/components/Footer.astro'

import {loadQuery} from '~/lib/load-query'
import {getDraftModeProps} from '~/lib/draft-mode'
import {imageUrl} from '~/lib/imageUrl'
import {stegaClean} from '@sanity/client/stega'
import {createDataAttribute} from '@sanity/visual-editing'
import {
  SITE_SETTINGS_QUERY,
  PAGE_BY_SLUG_QUERY,
  SERVICES_BY_CATEGORY_QUERY,
  type SiteSettings,
  type Page,
  type Service,
} from '~/lib/queries'

const draftProps = getDraftModeProps(Astro.cookies)

const [{data: settings}, {data: page}, {data: services}] = await Promise.all([
  loadQuery<SiteSettings | null>({query: SITE_SETTINGS_QUERY, ...draftProps}).catch(() => ({
    data: null,
    sourceMap: undefined,
    perspective: 'published' as const,
  })),
  loadQuery<Page | null>({
    query: PAGE_BY_SLUG_QUERY,
    params: {slug: 'videos'},
    ...draftProps,
  }).catch(() => ({data: null, sourceMap: undefined, perspective: 'published' as const})),
  loadQuery<Service[]>({
    query: SERVICES_BY_CATEGORY_QUERY,
    params: {category: 'video'},
    ...draftProps,
  }).catch(() => ({data: [], sourceMap: undefined, perspective: 'published' as const})),
])

// SEO
const pageTitle = page?.seo?.metaTitle ?? `Video Production London Ontario | ${settings?.title ?? 'Sharp by Tony'}`
const pageDescription =
  page?.seo?.metaDescription ??
  'Professional video production in London, Ontario. From detailed pre-production planning to on-set execution and polished delivery—sharp, strategic video content for your brand.'
const ogImageUrl = page?.seo?.ogImage?.asset
  ? imageUrl(page.seo.ogImage, {width: 1200, height: 630, quality: 85})
  : undefined
const noIndex = page?.seo?.noIndex ?? false
const favicon = settings?.favicon?.asset ? imageUrl(settings.favicon, {width: 32, height: 32}) : undefined

const heroBg = page?.heroBackground?.asset
  ? imageUrl(page.heroBackground, {width: 1920, height: 800, quality: 85})
  : null
const logoUrl = settings?.logo?.asset ? imageUrl(settings.logo, {width: 400}) : undefined
const sameAs = settings?.socialLinks?.length ? settings.socialLinks.map((l) => stegaClean(l.url)) : undefined
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImageUrl}
  favicon={favicon}
  noIndex={noIndex}
  contactEmail={settings?.contactEmail}
  contactPhone={settings?.contactPhone}
  address={settings?.address}
  logoUrl={logoUrl}
  sameAs={sameAs}
>
  <Header currentPath="/videos" settings={settings} />

  <main id="main-content">

    <!-- ─────────────────────────── VIDEO HERO ─────────────────────────── -->
    <section class="relative w-full bg-black overflow-hidden flex items-center justify-center" style="min-height: clamp(320px, 50vh, 560px);" aria-label="Video hero">
      {heroBg && (
        <img
          src={heroBg}
          alt="Sharp by Tony video production"
          fetchpriority="high"
          width="1920"
          height="800"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
      )}
      <div class="absolute inset-0 bg-black/60" aria-hidden="true" />
      <div class="relative z-10 flex flex-col items-center justify-center h-full px-6 py-20 text-center">
        <div class="hero-text">
          <p class="text-[12px] font-bold tracking-[0.3em] uppercase mb-3" style="color: #F5C645;">
            VIDEO | SHARP BY TONY
          </p>
          <h1
            class="text-white text-[48px] md:text-[72px] font-bold tracking-tight leading-none"
            data-sanity={page ? createDataAttribute({id: page._id, type: 'page', path: 'title'})() : undefined}
          >
            {page?.title ?? 'VIDEO.'}
          </h1>
          <p
            class="text-neutral-300 text-[16px] md:text-[18px] leading-relaxed max-w-xl mx-auto mt-6"
            data-sanity={page ? createDataAttribute({id: page._id, type: 'page', path: 'heroSubheading'})() : undefined}
          >
            {page?.heroSubheading ?? 'Professional video production in London, Ontario — from wedding films to commercial reels, executed with technical precision and creative intent.'}
          </p>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────── SERVICE CARDS ─────────────────────────── -->
    <section id="video-services" class="bg-black py-20">
      <div class="max-w-5xl mx-auto px-6">

        {page?.heroHeading && (
          <div class="mb-12 text-center" data-animate>
            <h2
              class="text-white text-[32px] md:text-[48px] font-bold tracking-tight"
              data-sanity={page ? createDataAttribute({id: page._id, type: 'page', path: 'heroHeading'})() : undefined}
            >
              {page.heroHeading}
            </h2>
          </div>
        )}

        {services && services.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
            {(services as Service[]).map((service, i) => (
              <a
                href={`/video/${service.slug.current}`}
                class="group relative block aspect-[4/3] overflow-hidden bg-neutral-900 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#F5C645] focus:ring-offset-2 focus:ring-offset-black"
                data-animate
                data-delay={i * 100}
                data-sanity={createDataAttribute({id: service._id, type: 'service', path: 'heroImage'})()}
              >
                {service.heroImage?.asset && (
                  <img
                    src={imageUrl(service.heroImage, {width: 800, height: 600, quality: 85})}
                    alt={service.heroImage.alt}
                    width="800"
                    height="600"
                    class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" />
                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="absolute inset-x-0 bottom-0 p-6 flex flex-col gap-2">
                  <p class="text-[11px] font-bold tracking-[0.3em] uppercase" style="color: #F5C645;">
                    VIDEO | SHARP BY TONY
                  </p>
                  <h2 class="text-white text-[28px] md:text-[36px] font-bold tracking-tight leading-none">
                    {service.title}
                  </h2>
                  <p class="service-summary text-neutral-300 text-[14px] leading-[1.7] max-w-sm">
                    {service.summary}
                  </p>
                  <div class="service-cta flex items-center gap-2 mt-1">
                    <span class="text-[11px] font-bold tracking-[0.25em] uppercase" style="color: #F5C645;">
                      Learn More
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#F5C645" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-neutral-500 text-center text-[14px]">Services coming soon.</p>
        )}
      </div>
    </section>

    <!-- ──────────────────────── CONTACT ──────────────────────── -->
    <ContactSection settings={settings} />
  </main>

  <Footer settings={settings} />
</BaseLayout>

<style>
  @keyframes fade-up {
    from {opacity: 0; transform: translateY(24px);}
    to {opacity: 1; transform: translateY(0);}
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-text {
      animation: fade-up 0.6s ease-out both;
    }
  }

  [data-animate] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {opacity: 1; transform: none; transition: none;}
  }

</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0
            setTimeout(() => el.classList.add('is-visible'), delay)
            observer.unobserve(el)
          }
        })
      },
      {threshold: 0.12},
    )
    document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el))
  }
</script>
