---
import '~/styles/global.css'
import SanityVisualEditing from '~/components/SanityVisualEditing'
import DisableDraftMode from '~/components/DisableDraftMode'
import {perspectiveCookieName} from '@sanity/preview-url-secret/constants'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
}

const {
  title = 'Sharp by Tony | Video · Photo · Design',
  description = 'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.',
  ogImage,
  noIndex = false,
} = Astro.props

const draftMode = Astro.cookies.has(perspectiveCookieName)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Favicon -->
    <link
      rel="icon"
      href="https://static.wixstatic.com/media/c8520e_0cc463bf259b4cdc9725834f491af291~mv2.jpg/v1/fill/w_32,h_32,lg_1,usm_0.66_1.00_0.01/c8520e_0cc463bf259b4cdc9725834f491af291~mv2.jpg"
      type="image/jpeg"
    />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body class="bg-white text-black">
    <!-- Skip navigation for keyboard users (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#F5C645] focus:text-black focus:px-4 focus:py-2 focus:font-bold focus:text-[13px] focus:tracking-widest focus:uppercase focus:outline-none"
    >
      Skip to content
    </a>
    <slot />
    {draftMode && (
      <>
        <SanityVisualEditing client:only="react" />
        <DisableDraftMode client:only="react" />
      </>
    )}
  </body>
</html>
