---
import '~/styles/global.css'
import SanityVisualEditing from '~/components/SanityVisualEditing'
import DisableDraftMode from '~/components/DisableDraftMode'
import {perspectiveCookieName} from '@sanity/preview-url-secret/constants'
import {stegaClean} from '@sanity/client/stega'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogType?: string
  favicon?: string
  noIndex?: boolean
  contactEmail?: string
  contactPhone?: string
  address?: {locality?: string | null; region?: string | null}
  logoUrl?: string
  sameAs?: string[]
}

const {
  title = 'Sharp by Tony | Video · Photo · Design',
  description = 'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.',
  ogImage,
  ogType = 'website',
  favicon,
  noIndex = false,
  contactEmail,
  contactPhone,
  address,
  logoUrl,
  sameAs,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, 'https://sharpbytony.com').href
const draftMode = Astro.cookies.has(perspectiveCookieName)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Sharp by Tony',
  url: 'https://sharpbytony.com',
  ...(logoUrl ? {image: logoUrl} : {}),
  ...(sameAs?.length ? {sameAs} : {}),
  ...(contactPhone ? {telephone: stegaClean(contactPhone)} : {}),
  ...(contactEmail ? {email: stegaClean(contactEmail)} : {}),
  ...(address?.locality || address?.region
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(address.locality ? {addressLocality: stegaClean(address.locality)} : {}),
          ...(address.region ? {addressRegion: stegaClean(address.region)} : {}),
        },
      }
    : {}),
  founder: {
    '@type': 'Person',
    name: 'Antonio Martinez',
  },
  serviceType: ['Video Production', 'Photography', 'Design'],
  areaServed: [
    {'@type': 'City', name: 'London, Ontario'},
    {'@type': 'AdministrativeArea', name: 'Ontario'},
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Sharp by Tony" />

    <!-- Favicon -->
    {favicon
      ? <link rel="icon" href={favicon} sizes="32x32" />
      : <>
          <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
          <link rel="icon" href="/favicon.ico" sizes="any" />
        </>
    }

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Page-specific head injections (e.g. FAQPage schema) -->
    <slot name="head" />
  </head>
  <body class="bg-white text-black">
    <!-- Skip navigation for keyboard users (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#F5C645] focus:text-black focus:px-4 focus:py-2 focus:font-bold focus:text-[13px] focus:tracking-widest focus:uppercase focus:outline-none"
    >
      Skip to content
    </a>
    <slot />
    {draftMode && <SanityVisualEditing client:only="react" />}
    {draftMode && <DisableDraftMode client:only="react" />}
  </body>
</html>
