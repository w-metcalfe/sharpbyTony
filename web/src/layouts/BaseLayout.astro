---
import '~/styles/global.css'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
}

const {
  title = 'Sharp by Tony | Video · Photo · Design',
  description = 'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.',
  ogImage,
  noIndex = false,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Favicon -->
    <link
      rel="icon"
      href="https://static.wixstatic.com/media/c8520e_0cc463bf259b4cdc9725834f491af291~mv2.jpg/v1/fill/w_32,h_32,lg_1,usm_0.66_1.00_0.01/c8520e_0cc463bf259b4cdc9725834f491af291~mv2.jpg"
      type="image/jpeg"
    />
  </head>
  <body class="bg-white text-black">
    <slot />
  </body>
</html>
