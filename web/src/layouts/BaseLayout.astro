---
import '~/styles/global.css'
import SanityVisualEditing from '~/components/SanityVisualEditing'
import DisableDraftMode from '~/components/DisableDraftMode'
import {perspectiveCookieName} from '@sanity/preview-url-secret/constants'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  favicon?: string
  noIndex?: boolean
}

const {
  title = 'Sharp by Tony | Video · Photo · Design',
  description = 'Sharp, strategic visuals for construction, lifestyle and luxury. Video, photo, and design by Antonio Martinez.',
  ogImage,
  favicon,
  noIndex = false,
} = Astro.props

const draftMode = Astro.cookies.has(perspectiveCookieName)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Favicon -->
    {favicon && <link rel="icon" href={favicon} type="image/jpeg" />}

    <!-- Canonical -->
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://sharpbytony.com').href} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body class="bg-white text-black">
    <!-- Skip navigation for keyboard users (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#F5C645] focus:text-black focus:px-4 focus:py-2 focus:font-bold focus:text-[13px] focus:tracking-widest focus:uppercase focus:outline-none"
    >
      Skip to content
    </a>
    <slot />
    {draftMode && <SanityVisualEditing client:only="react" />}
    {draftMode && <DisableDraftMode client:only="react" />}
  </body>
</html>
